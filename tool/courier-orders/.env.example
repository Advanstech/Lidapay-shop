# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Order creation (create-paid-orders.mjs) ---
# Mongo connection string for the shop database (users + products lookup).
MONGODB_URI=
# JWT signing secret used by the API to mint customer/admin tokens.
JWT_SECRET=
# LidaPay API base URL.
API_BASE=https://api.advansistechnologies.com

# ObjectIds of the accounts the script acts as.
# CUSTOMER_ID = the shop customer the orders belong to.
# ADMIN_ID    = a user whose roles include "admin" (marks payment success).
CUSTOMER_ID=
ADMIN_ID=
# Cheapest in-stock product used for each test order.
PRODUCT_ID=

# --- Courier queue check (check-courier-queue.mjs) ---
# Partner credentials exactly as deployed on the API. For the current
# temporary sandbox pair see docs/COURIER_API_PARTNER_HANDOFF_FRANK.md.
COURIER_PARTNER_ID=
COURIER_PARTNER_SECRET=
